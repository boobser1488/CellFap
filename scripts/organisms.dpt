// Организмы CellFap, написанные на dypt.
//
// Собирается в organisms.dll (dypt --lib --native) и загружается игрой при запуске. Наружу видны четыре
// функции: count(), name(i), description(i) и genome(i); геном отдаётся текстом в формате "CellFapGenome 1"
// (тот же, что у файлов в папке genomes). Поля, которые здесь не заданы, игра берёт по умолчанию.
//
// Здесь живут черви и рыбы с нервной системой: глаза и мозг в голове, пейсмейкер, эстафета нервных ганглиев вдоль
// тела и мышцы по обе стороны. Волна изгиба бежит от головы к хвосту, и вместе с анизотропным сопротивлением воды
// («плавание извиванием») она толкает тело вперёд.
//
// Пока тело растёт, оно не двигается: мозг и пейсмейкер — спящие стволовые клетки. Когда вырастает кончик хвоста,
// его нейрон подаёт сигнал зрелости S5, ганглии передают его к голове, и только тогда мозг и ритм просыпаются.

// ---------------------------------------------------------------- номера из движка
// Типы клеток (cell_types.hpp, порядок входит в формат файлов).
ФАГОЦИТ = 0
ФЛАГЕЛЛОЦИТ = 1
ФОТОЦИТ = 2
ДЕВОРОЦИТ = 3
ЛИПОЦИТ = 4
КЕРАТИНОЦИТ = 5
ГЛЮЕОЦИТ = 7
СТЕРЕОЦИТ = 10
СЕНСОЦИТ = 11
МИОЦИТ = 12
НЕЙРОЦИТ = 13
СТЕМОЦИТ = 15
ЦИЛИОЦИТ = 17
ГАМЕТА = 16
ЭЛЕКТРОЦИТ = 18
КНИДОЦИТ = 19
ХРОМАТОЦИТ = 20
ЛЮМИНОЦИТ = 21   // светится (приманка); глаза «на свет» плывут к нему
ЦИСТОЦИТ = 22    // спящая циста: просыпается в моду «stem», когда программа пути 1 > 0.5
ХВАТОЦИТ = 23    // хватает чужие клетки при хватке ≥ 0.3, стенку — при ≥ 0.8

// Программируемые поля (ProgField), входы (ProgInput) и виды функций (ProgKind).
П_ПЛАВАНИЕ = 0
П_СОКРАЩЕНИЕ = 2
П_ИЗГИБ = 3
П_ПУТЬ1 = 5
П_ЛЕВЫЕ_РЕСНИЧКИ = 3
П_ПРАВЫЕ_РЕСНИЧКИ = 4
П_ВЫХОД1 = 7
П_ВЫХОД2 = 8
П_ВЫХОД3 = 9
П_ВЫХОД4 = 10
ВХОД_КОНСТАНТА = 0
ВХОД_S1 = 1
ВХОД_S2 = 2
ВХОД_S3 = 3
ВХОД_S4 = 4
ВХОД_МАССА = 5
ВХОД_ВОЗРАСТ = 6
ВХОД_S5 = 9
ВХОД_S6 = 10
ВХОД_СВЕТ = 13
ВХОД_ЕДА = 14     // пища в 60 мкм вокруг, 0..1
ВХОД_РАНЕНИЕ = 15
ЛИНЕЙНАЯ = 0
СТУПЕНЬКА = 1
ВОЛНА = 2

ЦЕЛЬ_КЛЕТКИ = 0
ЦЕЛЬ_ПИЩА = 1
ЦЕЛЬ_СВЕТ = 3
ЦЕЛЬ_СТЕНА = 5
ЦЕЛЬ_КРОВЬ = 6   // клеточный сок раненых клеток в воде
// Каналы сигналов (0 = S1): S2 — команда мышцам, S5 — зрелость, S6 — глаза.
К_ЗРЕЛОСТЬ = 4
К_ГЛАЗА = 5
ЦВЕТ_ХИЩНИКА = "0.86 0.34 0.38 0.3"   // красные мышцы и клыки хищников
ЦВЕТ_ДОБЫЧИ = "0.42 0.78 0.40 0.3"    // зелёные водоросли и фотосинтезирующие ткани
ВСЁ = "1 1 1 0"
НИКОГДА = 99      // splitMass: не делиться
БОК = 90          // градусы

// Каналы эстафеты: S1 -> S3 -> S4 -> S7 -> S8 -> S1 (номера каналов с 0). Кольцо из пяти каналов: один и тот же
// канал повторяется только через 10 сегментов, и импульс не просачивается назад. S2 — команда мышцам.
ЭСТАФЕТА = [0, 2, 3, 6, 7]
ЗВЕНЬЕВ = 5
// Усиление ганглиев эстафеты и шаг между ганглиями. При малом усилении волна гаснет к середине тела (хвост не двигается);
// при ганглиях через сегмент импульс, растекаясь назад,
// замыкал кольцо из пяти каналов: оно
// защёлкивалось в постоянное смещение, и червь всё время загребал в одну сторону.
УСИЛЕНИЕ_ЭСТАФЕТЫ = 100
ШАГ_ГАНГЛИЕВ = 3
ПОВОРОТ_ВОЛНОЙ = 40
// Виды нервных ядер сегментов.
ВИДЫ = ["мозг", "пейсмейкер", "тяж", "ганглий0", "ганглий1", "ганглий2", "ганглий3", "ганглий4"]
ЧИСЛО_ВИДОВ = 8
ИМЕНА_ВИДОВ = ["мозг", "пейсмейкер", "тяж", "ганглий 1", "ганглий 2", "ганглий 3", "ганглий 4", "ганглий 5"]

// ---------------------------------------------------------------- геном
class Геном {
    имя: string = ""
    моды: map = {}
    счёт: int = 1

    function __init__(имя) {
        self.имя = имя
        self.моды = {}
        self.счёт = 1
    }

    // Новая свободная мода (0 — зигота).
    function новая() {
        if self.счёт >= 128 { print("ВНИМАНИЕ: в геноме «" + self.имя + "» больше 128 мод — лишние сольются") }
        self.счёт = self.счёт + 1
        return self.счёт - 1
    }

    // Строка " ключ значение" в описании моды i (повторный ключ заменяет прежнее значение).
    function поле(i, ключ, значение) {
        к = "" + i
        if not has(self.моды, к) { self.моды[к] = {} }
        м = self.моды[к]
        м[ключ] = "" + значение
    }

    // Растущие клетки (зоны роста, сегменты, пока делятся) питаются пищей, а не светом: так зародыш хищника растёт и в
    // тёмной чашке, если рот уже вырос и ест.
    function рост_едой() {
        номера = keys(self.моды)
        for n = 0 to length(номера) - 1 {
            м = self.моды[номера[n]]
            if has(м, "type") and has(м, "splitMass") {
                if м["type"] == "2" and м["splitMass"] == "1.78" { м["type"] = "0" }
            }
        }
    }

    // Имя моды для редактора (необязательно).
    function назвать(i, имя) {
        self.поле(i, "label", имя)
    }

    function клетка(i, тип, цвет) {
        self.поле(i, "type", тип)
        self.поле(i, "color", "" + цвет[0] + " " + цвет[1] + " " + цвет[2])
    }

    function ребёнок(i, номер, мода, угол) {
        self.поле(i, "child " + номер, "" + мода + " " + угол + " 1 0")
    }

    function программа(i, поле, вход, вид, a, b, c) {
        self.поле(i, "prog " + поле, "" + вход + " " + вид + " " + a + " " + b + " " + c)
    }

    function текст() {
        t = "CellFapGenome 1\nname " + self.имя + "\ninitial 0\n"
        номера = keys(self.моды)
        for n = 0 to length(номера) - 1 {
            к = номера[n]
            t = t + "mode " + к + "\n"
            м = self.моды[к]
            ключи = keys(м)
            for j = 0 to length(ключи) - 1 {
                t = t + " " + ключи[j] + " " + м[ключи[j]] + "\n"
            }
        }
        return t + "end\n"
    }
}

// Растущая клетка: фотосинтезирует, пока тело развивается, и делится при 1.78 нг.
function растущая(г, i, цвет, жёсткость) {
    г.клетка(i, ФОТОЦИТ, цвет)
    г.поле(i, "makeAdhesin", 1)
    г.поле(i, "stiffness", жёсткость)
    г.поле(i, "splitMass", 1.78)
    г.поле(i, "priority", 2)
}

// Конечная клетка: больше не делится.
function конечная(г, i, тип, цвет, жёсткость) {
    г.клетка(i, тип, цвет)
    г.поле(i, "splitMass", НИКОГДА)
    г.поле(i, "stiffness", жёсткость)
}

// Деление вбок: первый ребёнок уходит в сторону `угол`, оба продолжают смотреть вдоль тела.
function вбок(г, i, угол, первый, второй) {
    г.поле(i, "splitAngle", угол)
    г.ребёнок(i, 0, первый, -угол)
    г.ребёнок(i, 1, второй, -угол)
}

// Деление вдоль тела: первый ребёнок впереди, второй сзади.
function вперёд(г, i, первый, второй) {
    г.ребёнок(i, 0, первый, 0)
    г.ребёнок(i, 1, второй, 0)
}

// Ряд из двух одинаковых клеток (левая и правая — одна мода: тело зеркально симметрично).
function пара(г, i, цвет, жёсткость, клетка) {
    растущая(г, i, цвет, жёсткость)
    вбок(г, i, БОК, клетка, клетка)
}

// ---------------------------------------------------------------- нервная система
function нейрон(г, i, цвет, жёсткость) {
    конечная(г, i, НЕЙРОЦИТ, цвет, жёсткость)
}

// Спящий предшественник: стволовая клетка, которая становится `во_что`, когда приходит сигнал зрелости S5.
function спящий(г, i, во_что, цвет, жёсткость, имя) {
    конечная(г, i, СТЕМОЦИТ, цвет, жёсткость)
    г.назвать(i, имя)
    г.поле(i, "stem", "" + во_что + " " + во_что)
    г.программа(i, П_ПУТЬ1, ВХОД_S5, СТУПЕНЬКА, 0, 1, 0.15)
}

// Нейрон на кончике хвоста: появляется последним и постоянно подаёт сигнал зрелости S5.
function нейрон_зрелости(г, i, жёсткость) {
    нейрон(г, i, [0.86, 0.78, 0.95], жёсткость)
    г.назвать(i, "Нейрон зрелости (кончик хвоста)")
    г.программа(i, П_ВЫХОД1, ВХОД_КОНСТАНТА, ЛИНЕЙНАЯ, 0, 20, 0)
    г.поле(i, "neuro", "" + К_ЗРЕЛОСТЬ + " 1 2 3")
}

// Нервные моды тела. Возвращает словарь: мозг и пейсмейкер (спящие формы для сегментов), их рабочие формы
// «мозг_раб», «пейсмейкер_раб», нервный тяж и три ганглия эстафеты.
function нервные_моды(г, жёсткость, ритм) {
    return нервные_моды_пп(г, жёсткость, ритм, 1, 1)
}

// поворот — знак и сила поворотной команды. У широкого тела, которое в основном сокращает мышцы, смещение волны
// поворачивает в сторону, противоположную сокращённой (нематода: отрицательный поворот).
function нервные_моды_п(г, жёсткость, ритм, поворот) {
    return нервные_моды_пп(г, жёсткость, ритм, поворот, поворот)
}

// голова — знак и сила поворота головы мозгом, тело — смещение волны вдоль тела (тяж и ганглии).
function нервные_моды_пп(г, жёсткость, ритм, голова, тело) {
    я = {}
    имена = ["мозг", "пейсмейкер", "тяж", "ганглий0", "ганглий1", "ганглий2", "ганглий3", "ганглий4", "мозг_раб", "пейсмейкер_раб"]
    for t = 0 to 9 { я[имена[t]] = г.новая() }
    // Мозг: усиливает сигнал глаз (S6) и отдаёт его мышцам головы как команду S2 — с насыщением, так что даже далёкая
    // цель поворачивает голову: голова смотрит на пищу, тело плывёт следом.
    нейрон(г, я["мозг_раб"], [1.0, 0.80, 0.50], жёсткость)
    г.назвать(я["мозг_раб"], "Мозг")
    г.программа(я["мозг_раб"], П_ВЫХОД1, ВХОД_S6, ЛИНЕЙНАЯ, 60 * голова, 0, 0)
    г.поле(я["мозг_раб"], "neuro", "1 1 2 3")
    // Пейсмейкер: ритм — волна от собственного возраста на S1, запускает эстафету ганглиев. Головой он не машет: голову
    // ведёт мозг (иначе ритм заглушает глаза и червь плывёт мимо пищи).
    нейрон(г, я["пейсмейкер_раб"], [1.0, 0.62, 0.36], жёсткость)
    г.назвать(я["пейсмейкер_раб"], "Пейсмейкер")
    г.программа(я["пейсмейкер_раб"], П_ВЫХОД1, ВХОД_ВОЗРАСТ, ВОЛНА, 20, 0, ритм)
    // Поворот всем телом: сигнал глаз подмешивается к ритму. Эстафета насыщена и передаёт к хвосту только моменты смены
    // знака, поэтому смещённая волна доходит как неравные полуволны: одна сторона тела сокращена дольше, тело идёт дугой.
    г.программа(я["пейсмейкер_раб"], П_ВЫХОД2, ВХОД_S6, ЛИНЕЙНАЯ, ПОВОРОТ_ВОЛНОЙ * тело, 0, 0)
    г.поле(я["пейсмейкер_раб"], "neuro", "0 0 2 3")
    спящий(г, я["мозг"], я["мозг_раб"], [0.96, 0.82, 0.62], жёсткость, "Мозг (созревает)")
    спящий(г, я["пейсмейкер"], я["пейсмейкер_раб"], [0.96, 0.70, 0.52], жёсткость, "Пейсмейкер (созревает)")
    // Нервный тяж между ганглиями проводит сигналы и передаёт к голове сигнал зрелости.
    нейрон(г, я["тяж"], [0.94, 0.88, 0.70], жёсткость)
    г.назвать(я["тяж"], "Нервный тяж")
    г.программа(я["тяж"], П_ВЫХОД1, ВХОД_S5, СТУПЕНЬКА, 0, 20, 0.1)   // передаёт сигнал зрелости
    // Тяж несёт решение мозга вдоль тела: сигнал глаз S6 передаётся дальше (с затуханием) и смещает команду мышцам S2.
    г.программа(я["тяж"], П_ВЫХОД2, ВХОД_S6, ЛИНЕЙНАЯ, 0.7, 0, 0)
    г.программа(я["тяж"], П_ВЫХОД3, ВХОД_S6, ЛИНЕЙНАЯ, 5 * тело, 0, 0)
    г.поле(я["тяж"], "neuro", "" + К_ЗРЕЛОСТЬ + " " + К_ГЛАЗА + " 1 3")
    // Ганглий f слушает канал предыдущего и передаёт импульс на следующий (к хвосту), вторым выходом даёт мышцам
    // команду S2 того же знака. Передача линейная с насыщением: в покое ганглий молчит (ни одна сторона не
    // сокращается), а импульс любого знака восстанавливает до полной силы. Третий выход передаёт сигнал зрелости.
    for f = 0 to ЗВЕНЬЕВ - 1 {
        i = я["ганглий" + f]
        нейрон(г, i, [0.98, 0.90, 0.60], жёсткость)
        г.назвать(i, "Ганглий " + (f + 1))
        вход = вход_канала(ЭСТАФЕТА[f])
        свой = ЭСТАФЕТА[(f + 1) % ЗВЕНЬЕВ]
        г.программа(i, П_ВЫХОД1, вход, ЛИНЕЙНАЯ, УСИЛЕНИЕ_ЭСТАФЕТЫ, 0, 0)
        г.программа(i, П_ВЫХОД2, вход_канала(свой), ЛИНЕЙНАЯ, УСИЛЕНИЕ_ЭСТАФЕТЫ, 0, 0)
        г.программа(i, П_ВЫХОД3, ВХОД_S5, СТУПЕНЬКА, 0, 20, 0.1)
        г.программа(i, П_ВЫХОД4, ВХОД_S6, ЛИНЕЙНАЯ, 5 * тело, 0, 0)   // поворот: смещение команды мышцам
        г.поле(i, "neuro", "" + свой + " 1 " + К_ЗРЕЛОСТЬ + " 1")
    }
    return я
}

// Вход программы, читающий канал k (S1..S4 — входы 1..4, S5..S8 — 9..12).
function вход_канала(k) {
    if k < 4 { return ВХОД_S1 + k }
    return ВХОД_S5 + k - 4
}

// Какое нервное ядро у сегмента k: мозг в голове, пейсмейкер в последнем головном сегменте, дальше ганглий через
// сегмент, а между ними нервный тяж.
function вид_ядра(k, голова) {
    if k < голова - 1 { return "мозг" }
    if k == голова - 1 { return "пейсмейкер" }
    b = k - голова
    // Ганглии через ШАГ_ГАНГЛИЕВ сегментов, между ними нервный тяж. Чем реже ганглии, тем длиннее кольцо каналов и тем
    // слабее импульс, просочившийся назад по телу: эстафета не защёлкивается в постоянное смещение.
    if b % ШАГ_ГАНГЛИЕВ != ШАГ_ГАНГЛИЕВ - 1 { return "тяж" }
    return "ганглий" + (((b + 1) / ШАГ_ГАНГЛИЕВ - 1) % ЗВЕНЬЕВ)
}

function имя_вида(вид) {
    for t = 0 to ЧИСЛО_ВИДОВ - 1 {
        if ВИДЫ[t] == вид { return ИМЕНА_ВИДОВ[t] }
    }
    return вид
}

// Мышца пропорциональна S2: левая сокращается при S2 > 0, правая при S2 < 0; уже S2 = ±2.5 даёт полное
// сокращение, а смещение от глаз (поворот) добавляется к нему — тело плывёт по дуге. В покое (S2 = 0) обе стороны
// расслаблены одинаково.
function мышца(г, i, левая, жёсткость, сила) {
    if левая {
        конечная(г, i, МИОЦИТ, [0.88, 0.40, 0.44], жёсткость)
        г.назвать(i, "Мышца левая")
        г.программа(i, П_СОКРАЩЕНИЕ, ВХОД_S2, ЛИНЕЙНАЯ, сила / 0.5, 0, 0)
    } else {
        конечная(г, i, МИОЦИТ, [0.88, 0.40, 0.44], жёсткость)
        г.назвать(i, "Мышца правая")
        г.программа(i, П_СОКРАЩЕНИЕ, ВХОД_S2, ЛИНЕЙНАЯ, -сила / 0.5, 0, 0)
    }
    г.поле(i, "priority", 2)
}

// Цепочка зон роста: зона k даёт вперёд сегмент сегменты[k] и назад — следующую зону; последняя — хвост.
function зоны_роста(г, сегменты, хвост, жёсткость) {
    n = length(сегменты)
    первая = г.новая()
    for k = 1 to n - 1 { г.новая() }
    for k = 0 to n - 1 {
        i = первая + k
        растущая(г, i, [0.58, 0.74, 0.50], жёсткость)
        г.поле(i, "priority", 3)
        г.назвать(i, "Зона роста " + (k + 1))
        дальше = хвост
        if k + 1 < n { дальше = i + 1 }
        вперёд(г, i, сегменты[k], дальше)
    }
    return первая
}

// То же, но каждая зона роста даёт сразу два сегмента (через клетку-пару, делящуюся вперёд и назад): вдвое меньше
// мод на длинное тело (в геноме их не больше 128).
function зоны_роста_парами(г, сегменты, хвост, жёсткость) {
    n = length(сегменты)
    зон = (n + 1) / 2
    пары = {}
    первая = г.новая()
    for k = 1 to зон - 1 { г.новая() }
    for k = 0 to зон - 1 {
        i = первая + k
        растущая(г, i, [0.58, 0.74, 0.50], жёсткость)
        г.поле(i, "priority", 3)
        г.назвать(i, "Зона роста " + (k + 1))
        дальше = хвост
        if k + 1 < зон { дальше = i + 1 }
        a = сегменты[2 * k]
        вперёд_мода = a
        if 2 * k + 1 < n {
            b = сегменты[2 * k + 1]
            ключ = "" + a + "," + b
            if not has(пары, ключ) {
                p = г.новая()
                растущая(г, p, [0.58, 0.74, 0.50], жёсткость)
                г.назвать(p, "Пара сегментов")
                вперёд(г, p, a, b)
                пары[ключ] = p
            }
            вперёд_мода = пары[ключ]
        }
        вперёд(г, i, вперёд_мода, дальше)
    }
    return первая
}

// Сегменты шести видов для тела «бок | ядро ядро | бок»: сегмент сразу делится на левую и правую половины (бока
// растут одновременно, тело зеркально), каждая половина — на бок и нервную клетку; нервные клетки обеих половин
// одинаковые: парный нервный тяж. Возвращает словарь вид -> мода сегмента.
function сегменты_тела(г, я, L1, R1, цвет, жёсткость) {
    сег = {}
    for t = 0 to ЧИСЛО_ВИДОВ - 1 {
        вид = ВИДЫ[t]
        s = г.новая()
        л = г.новая()
        п = г.новая()
        растущая(г, s, цвет, жёсткость)
        вбок(г, s, БОК, л, п)
        растущая(г, л, цвет, жёсткость)
        вбок(г, л, БОК, L1, я[вид])
        растущая(г, п, цвет, жёсткость)
        вбок(г, п, -БОК, R1, я[вид])
        г.назвать(s, "Сегмент: " + ИМЕНА_ВИДОВ[t])
        г.назвать(л, "Левая половина: " + ИМЕНА_ВИДОВ[t])
        г.назвать(п, "Правая половина: " + ИМЕНА_ВИДОВ[t])
        сег[вид] = s
    }
    return сег
}

function список_сегментов(сег, сегментов, голова) {
    список = []
    for k = 0 to сегментов - 1 { push(список, сег[вид_ядра(k, голова)]) }
    return список
}

// Стереоглаз: знак сигнала говорит, слева (+) или справа (-) цель. `сила` > 0 — поворачивать к цели,
// < 0 — от неё (стены, хищники). Глаза пишут в S6, мозг передаёт это мышцам.
function стереоглаз(г, i, цель, сила, цвет_цели, цвет, имя) {
    конечная(г, i, СТЕРЕОЦИТ, цвет, 0.3)
    г.поле(i, "sense", "" + цель + " " + К_ГЛАЗА + " " + сила + " " + цвет_цели)
    г.назвать(i, имя)
}

// ---------------------------------------------------------------- голова
// Голова: зигота делит вперёд голову и назад первую зону роста. Сама голова — ряды по четыре клетки:
//   рот (если есть): губа | клык | клык | губа (у мирных — губы вместо клыков),
//   нос: глаз на пищу | второй глаз | второй глаз | глаз на пищу,
//   затылок: глаз на стены | глаз на стены.
// Левая и правая клетки каждого ряда — одна и та же мода, так что голова зеркально симметрична.
// второй_глаз = [цель, сила, цвет_цели, цвет, имя].
function голова(г, зона, жёсткость, рот_вид, второй_глаз, сила_пищи) {
    растущая(г, 0, [0.62, 0.76, 0.52], жёсткость)
    г.назвать(0, "Зигота")
    нос = г.новая()
    нос_ряд = г.новая()
    нос_л = г.новая()
    нос_п = г.новая()
    затылок = г.новая()
    глаз_пища = г.новая()
    глаз_2 = г.новая()
    глаз_стена = г.новая()
    кожа = [0.86, 0.62, 0.48]
    первая = нос
    if рот_вид > 0 {
        голова_м = г.новая()
        рот = г.новая()
        рот_л = г.новая()
        рот_п = г.новая()
        губа = г.новая()
        клык = г.новая()
        растущая(г, голова_м, кожа, жёсткость)
        вперёд(г, голова_м, рот, нос)
        растущая(г, рот, кожа, жёсткость)
        вбок(г, рот, БОК, рот_л, рот_п)
        растущая(г, рот_л, кожа, жёсткость)
        вбок(г, рот_л, БОК, губа, клык)
        растущая(г, рот_п, кожа, жёсткость)
        вбок(г, рот_п, -БОК, губа, клык)
        конечная(г, губа, ФАГОЦИТ, [0.90, 0.66, 0.50], жёсткость)
        г.назвать(губа, "Губа (ест пищу)")
        if рот_вид == 1 {
            конечная(г, клык, ДЕВОРОЦИТ, [0.80, 0.22, 0.30], жёсткость)
            г.назвать(клык, "Клык (ест клетки)")
        } else {
            конечная(г, клык, ФАГОЦИТ, [0.98, 0.70, 0.45], жёсткость)
            г.назвать(клык, "Губа, середина")
        }
        г.назвать(голова_м, "Голова")
        г.назвать(рот, "Рот")
        г.назвать(рот_л, "Рот, левая часть")
        г.назвать(рот_п, "Рот, правая часть")
        первая = голова_м
    }
    вперёд(г, 0, первая, зона)
    растущая(г, нос, кожа, жёсткость)
    вперёд(г, нос, нос_ряд, затылок)
    растущая(г, нос_ряд, кожа, жёсткость)
    вбок(г, нос_ряд, БОК, нос_л, нос_п)
    растущая(г, нос_л, кожа, жёсткость)
    вбок(г, нос_л, БОК, глаз_пища, глаз_2)
    растущая(г, нос_п, кожа, жёсткость)
    вбок(г, нос_п, -БОК, глаз_пища, глаз_2)
    пара(г, затылок, кожа, жёсткость, глаз_стена)
    г.назвать(нос, "Нос")
    г.назвать(нос_ряд, "Нос, ряд глаз")
    г.назвать(нос_л, "Нос, левая часть")
    г.назвать(нос_п, "Нос, правая часть")
    г.назвать(затылок, "Затылок")
    стереоглаз(г, глаз_пища, ЦЕЛЬ_ПИЩА, сила_пищи, ВСЁ, [0.98, 0.52, 0.30], "Глаз на пищу")
    стереоглаз(г, глаз_2, второй_глаз[0], второй_глаз[1], второй_глаз[2], второй_глаз[3], второй_глаз[4])
    стереоглаз(г, глаз_стена, ЦЕЛЬ_СТЕНА, -15, ВСЁ, [0.75, 0.75, 0.85], "Глаз на стены")
}

// ---------------------------------------------------------------- нематода
// Тонкий всеядный хищник 6 клеток в ширину и 40 сегментов. Органы:
//   мышцы — по две продольные ленты на каждой стороне; нервы — парный нервный тяж с ганглиями, мозг, пейсмейкер;
//   пасть — губы глотают пищу, клыки высасывают добычу; глаза на пищу, на зелёную добычу и на стены;
//   гонады — в середине тела вместо внешней мышцы: сытая гонада выпускает гамету; две гаметы (свои или чужие) сливаются в
//   яйцо, через 3 часа из яйца вылупляется личинка. Зародыш растёт на еде, которую ловит его рот.
function нематода() {
    г = Геном("Нематода")
    сегментов = 40
    голова_сегм = 3
    жёсткость = 0.3
    цвет = [0.62, 0.78, 0.52]
    я = нервные_моды(г, жёсткость, 1.5)
    левая = г.новая()
    правая = г.новая()
    мышца(г, левая, true, жёсткость, 0.38)
    мышца(г, правая, false, жёсткость, 0.38)
    // Ресничный покров: тянет тело вдоль оси, а мышцы изгибают его, как руль, — так длинное широкое тело поворачивает
    // к цели (одной волной изгиба оно почти не разворачивается).
    ресн_нем = г.новая()
    ресничная(г, ресн_нем, [0.66, 0.78, 0.86], жёсткость, 0.9)

    // Размножение
    гонада_л = г.новая()
    гонада_п = г.новая()
    гамета = г.новая()
    яйцо = г.новая()
    for s = 0 to 1 {
        i = гонада_л
        угол = БОК
        if s == 1 {
            i = гонада_п
            угол = -БОК
        }
        г.клетка(i, ФАГОЦИТ, [0.95, 0.72, 0.80])
        г.поле(i, "stiffness", жёсткость)
        г.поле(i, "splitMass", 3.2)
        г.поле(i, "priority", 0.3)   // наполняется последней: размножается только сытое тело
        г.поле(i, "splitAngle", угол)
        г.поле(i, "child 0", "" + гамета + " " + (-угол) + " 0 0")   // гамета уходит наружу, без адгезина
        г.поле(i, "child 1", "" + i + " " + (-угол) + " 1 0")        // гонада остаётся в теле
        if s == 0 { г.назвать(i, "Гонада левая") } else { г.назвать(i, "Гонада правая") }
    }
    г.клетка(гамета, 16, [1.0, 0.82, 0.88])
    г.поле(гамета, "splitMass", НИКОГДА)
    г.поле(гамета, "gamete", "" + гамета + " " + яйцо + " 0")
    г.назвать(гамета, "Гамета")
    конечная(г, яйцо, СТЕМОЦИТ, [0.96, 0.94, 0.84], 0.5)
    г.поле(яйцо, "stem", "0 0")
    г.программа(яйцо, П_ПУТЬ1, ВХОД_ВОЗРАСТ, СТУПЕНЬКА, 0, 1, 0.0125)   // 3 часа из 240
    г.назвать(яйцо, "Яйцо")
    // Бока: реснички снаружи и мышца внутри; в середине тела реснички заменены гонадой.
    бок = {}
    for s = 0 to 1 {
        угол = БОК
        мыш = левая
        гон = гонада_л
        if s == 1 {
            угол = -БОК
            мыш = правая
            гон = гонада_п
        }
        б = г.новая()
        растущая(г, б, цвет, жёсткость)
        вбок(г, б, угол, ресн_нем, мыш)   // снаружи реснички (тянут вперёд), внутри мышца (руль и волна)
        бок["" + s + "0"] = б
        г.назвать(б, "Бок")
        бг = г.новая()
        растущая(г, бг, цвет, жёсткость)
        вбок(г, бг, угол, гон, мыш)
        бок["" + s + "1"] = бг
        г.назвать(бг, "Бок с гонадой")
    }
    // Сегменты: обычные и с гонадами (середина тела).
    сег = сегменты_тела(г, я, бок["00"], бок["10"], цвет, жёсткость)
    сег_г = {}
    сегменты = []
    for k = 0 to сегментов - 1 {
        вид = вид_ядра(k, голова_сегм)
        if k >= 18 and k < 22 {
            if not has(сег_г, вид) {
                s = г.новая()
                л = г.новая()
                п = г.новая()
                растущая(г, s, цвет, жёсткость)
                вбок(г, s, БОК, л, п)
                растущая(г, л, цвет, жёсткость)
                вбок(г, л, БОК, бок["01"], я[вид])
                растущая(г, п, цвет, жёсткость)
                вбок(г, п, -БОК, бок["11"], я[вид])
                г.назвать(s, "Сегмент с гонадами: " + имя_вида(вид))
                сег_г[вид] = s
            }
            push(сегменты, сег_г[вид])
        } else {
            push(сегменты, сег[вид])
        }
    }
    хвост = г.новая()
    нейрон_зрелости(г, хвост, жёсткость)
    зона = зоны_роста_парами(г, сегменты, хвост, жёсткость)
    голова(г, зона, жёсткость, 1, [ЦЕЛЬ_КЛЕТКИ, 7, ЦВЕТ_ДОБЫЧИ, [0.60, 0.86, 0.36], "Глаз на добычу"], 8)
    г.рост_едой()
    return г
}

// ---------------------------------------------------------------- гигантский червь
// 45 сегментов по 10 клеток, плоский, как планария: парный нервный тяж, на каждой стороне две мышечные ленты и две
// ресничные (через одну): реснички тянут вперёд, мышцы изгибают тело и поворачивают его к пище.
function гигант() {
    г = Геном("Червь-гигант")
    сегментов = 45
    жёсткость = 0.3
    цвет = [0.60, 0.80, 0.48]
    я = нервные_моды(г, жёсткость, 2.0)
    левая = г.новая()
    правая = г.новая()
    мышца(г, левая, true, жёсткость, 0.4)
    мышца(г, правая, false, жёсткость, 0.4)
    // Ребро от тяжа наружу: три мышечные ленты, снаружи — ресничный край. Широкое плоское тело почти не плывёт
    // извиванием, поэтому гигант ползёт на ресничках, как планария, а мышцы изгибают его и поворачивают к пище.
    ресн = г.новая()
    ресничная(г, ресн, [0.55, 0.70, 0.92], жёсткость, 0.9)
    рёбра = []
    for s = 0 to 1 {
        угол = БОК
        мыш = левая
        if s == 1 {
            угол = -БОК
            мыш = правая
        }
        р1 = г.новая()
        р2 = г.новая()
        р3 = г.новая()
        растущая(г, р1, цвет, жёсткость)
        вбок(г, р1, угол, р2, мыш)
        растущая(г, р2, цвет, жёсткость)
        вбок(г, р2, угол, р3, ресн)   // ленты чередуются: мышца, реснички, мышца, реснички
        растущая(г, р3, цвет, жёсткость)
        вбок(г, р3, угол, ресн, мыш)   // снаружи — реснички (ползёт, как планария), внутри — мышца
        if s == 0 { г.назвать(р1, "Ребро левое") } else { г.назвать(р1, "Ребро правое") }
        push(рёбра, р1)
    }
    сег = сегменты_тела(г, я, рёбра[0], рёбра[1], цвет, жёсткость)
    хвост = г.новая()
    нейрон_зрелости(г, хвост, жёсткость)
    зона = зоны_роста_парами(г, список_сегментов(сег, сегментов, 4), хвост, жёсткость)
    голова(г, зона, жёсткость, 2, [ЦЕЛЬ_ПИЩА, 6, ВСЁ, [0.98, 0.52, 0.30], "Глаз на пищу"], 6)
    г.рост_едой()
    return г
}

// ---------------------------------------------------------------- тонкие черви
// Ресничная клетка: бьёт ресничками назад и скользит вперёд, но только когда тело созрело (сигнал S5).
function ресничная(г, i, цвет, жёсткость, скорость) {
    конечная(г, i, ЦИЛИОЦИТ, цвет, жёсткость)
    г.назвать(i, "Реснички")
    г.программа(i, П_ЛЕВЫЕ_РЕСНИЧКИ, ВХОД_S5, СТУПЕНЬКА, 0, скорость, 0.3)
    г.программа(i, П_ПРАВЫЕ_РЕСНИЧКИ, ВХОД_S5, СТУПЕНЬКА, 0, скорость, 0.3)
}

// Вёсла — руль у носа: ряд из двух клеток, развёрнутых наискосок наружу (±45°). Левое весло тянет нос влево, правое —
// вправо; сила каждого = база ± усиление · сигнал (сигнал > 0 — цель слева). Боковая сила у носа поворачивает длинное
// тело, а разница ресничек по бокам — почти нет: вода не даёт телу провернуться. тип — цилиоцит или флагеллоцит.
function вёсла(г, ряд, цвет, жёсткость, тип, вход, усиление, база, цвет_весла) {
    лев = г.новая()
    прав = г.новая()
    растущая(г, ряд, цвет, жёсткость)
    г.поле(ряд, "splitAngle", БОК)
    г.ребёнок(ряд, 0, лев, -БОК + 45)
    г.ребёнок(ряд, 1, прав, -БОК - 45)
    г.назвать(ряд, "Вёсла (руль)")
    for s = 0 to 1 {
        i = лев
        k = усиление
        if s == 1 {
            i = прав
            k = -усиление
        }
        конечная(г, i, тип, цвет_весла, жёсткость)
        if тип == ЦИЛИОЦИТ {
            г.программа(i, П_ЛЕВЫЕ_РЕСНИЧКИ, вход, ЛИНЕЙНАЯ, k, база, 0)
            г.программа(i, П_ПРАВЫЕ_РЕСНИЧКИ, вход, ЛИНЕЙНАЯ, k, база, 0)
        } else {
            г.программа(i, П_ПЛАВАНИЕ, вход, ЛИНЕЙНАЯ, k, база, 0)
        }
        if s == 0 { г.назвать(i, "Весло левое") } else { г.назвать(i, "Весло правое") }
    }
}

// Тонкий червь: 20 клеток в длину и 2 в ширину. Голова — рот, глаза на пищу и на стены, мозг и пейсмейкер (по паре
// клеток). Тело повторяет ряды «мышцы | ганглии | реснички»: мышцы изгибают тело волной, реснички помогают
// скользить. На кончике хвоста — пара нейронов зрелости.
function тонкий_червь() {
    г = Геном("Тонкий червь")
    жёсткость = 0.35
    цвет = [0.70, 0.80, 0.56]
    я = нервные_моды(г, жёсткость, 0.6)
    левая = г.новая()
    правая = г.новая()
    мышечный = г.новая()
    мышца(г, левая, true, жёсткость, 0.5)
    мышца(г, правая, false, жёсткость, 0.5)
    растущая(г, мышечный, цвет, жёсткость)
    вбок(г, мышечный, БОК, левая, правая)
    г.назвать(мышечный, "Ряд мышц")
    ресн = г.новая()
    ресн_ряд = г.новая()
    ресничная(г, ресн, [0.60, 0.70, 0.92], жёсткость, 0.8)
    пара(г, ресн_ряд, цвет, жёсткость, ресн)
    г.назвать(ресн_ряд, "Ряд ресничек")
    ряд = {}
    for t = 0 to ЧИСЛО_ВИДОВ - 1 {
        вид = ВИДЫ[t]
        r = г.новая()
        пара(г, r, цвет, жёсткость, я[вид])
        г.назвать(r, "Ряд: " + ИМЕНА_ВИДОВ[t])
        ряд[вид] = r
    }
    рот = г.новая()
    губа = г.новая()
    глаза = г.новая()
    глаз = г.новая()
    стенные = г.новая()
    глаз_стена = г.новая()
    пара(г, рот, цвет, жёсткость, губа)
    конечная(г, губа, ФАГОЦИТ, [0.90, 0.66, 0.50], жёсткость)
    пара(г, глаза, цвет, жёсткость, глаз)
    стереоглаз(г, глаз, ЦЕЛЬ_ПИЩА, 8, ВСЁ, [0.98, 0.52, 0.30], "Глаз на пищу")
    пара(г, стенные, цвет, жёсткость, глаз_стена)
    стереоглаз(г, глаз_стена, ЦЕЛЬ_СТЕНА, -15, ВСЁ, [0.75, 0.75, 0.85], "Глаз на стены")
    г.назвать(рот, "Рот")
    г.назвать(губа, "Губа (ест пищу)")
    г.назвать(глаза, "Ряд глаз на пищу")
    г.назвать(стенные, "Ряд глаз на стены")
    // 20 рядов: рот, глаза, глаза на стены, мозг, шея (мышцы), пейсмейкер, 13 рядов тела, хвост. Тело: ганглий, мышцы,
    // реснички, мышцы, ганглий... — каждый второй ряд мышечный, ганглии через три ряда передают волну к хвосту.
    сегменты = [рот, глаза, стенные, ряд["мозг"], мышечный, ряд["пейсмейкер"]]
    узор = ["г", "м", "р", "м"]
    ганглиев = 0
    for k = 0 to 12 {
        вид = узор[k % 4]
        if вид == "г" {
            push(сегменты, ряд["ганглий" + (ганглиев % ЗВЕНЬЕВ)])
            ганглиев = ганглиев + 1
        }
        if вид == "м" { push(сегменты, мышечный) }
        if вид == "р" { push(сегменты, ресн_ряд) }
    }
    хвост = г.новая()
    хвост_н = г.новая()
    нейрон_зрелости(г, хвост_н, жёсткость)
    пара(г, хвост, цвет, жёсткость, хвост_н)
    г.назвать(хвост, "Хвост")
    зона = зоны_роста(г, сегменты, хвост, жёсткость)
    растущая(г, 0, цвет, жёсткость)
    г.назвать(0, "Зигота")
    // Зигота сама становится первой зоной роста: рот растёт первым, хвост последним.
    вперёд(г, 0, рот, зона + 1)
    return г
}

// Нитчатый червь: цепочка из 15 клеток, как мелкие ресничные черви. Скользит ресничками; шея — мышца-сустав —
// поворачивает голову к пище и от стен (изгиб по сигналу мозга S2). Между ресничными клетками нервные клетки
// передают сигнал зрелости: пока червь растёт, реснички и мозг не работают.
function нитчатый_червь() {
    г = Геном("Нитчатый червь")
    жёсткость = 0.6
    цвет = [0.74, 0.70, 0.86]
    я = нервные_моды(г, жёсткость, 1.0)
    шея = г.новая()
    конечная(г, шея, МИОЦИТ, [0.88, 0.42, 0.50], жёсткость)
    г.назвать(шея, "Мышца-сустав")
    г.программа(шея, П_ИЗГИБ, ВХОД_S2, ЛИНЕЙНАЯ, 0.06, 0, 0)
    г.поле(шея, "priority", 2)
    ресн = г.новая()
    ресничная(г, ресн, [0.60, 0.66, 0.95], жёсткость, 0.8)
    связной = г.новая()
    нейрон(г, связной, [0.94, 0.88, 0.70], жёсткость)
    г.назвать(связной, "Нервная клетка")
    г.программа(связной, П_ВЫХОД1, ВХОД_S5, СТУПЕНЬКА, 0, 20, 0.1)
    г.поле(связной, "neuro", "" + К_ЗРЕЛОСТЬ + " 1 2 3")
    рот = г.новая()
    глаз = г.новая()
    глаз_стена = г.новая()
    конечная(г, рот, ФАГОЦИТ, [0.90, 0.66, 0.50], жёсткость)
    г.назвать(рот, "Рот")
    стереоглаз(г, глаз, ЦЕЛЬ_ПИЩА, 16, ВСЁ, [0.98, 0.52, 0.30], "Глаз на пищу")
    стереоглаз(г, глаз_стена, ЦЕЛЬ_СТЕНА, -30, ВСЁ, [0.75, 0.75, 0.85], "Глаз на стены")
    // 15 клеток: рот, два глаза, мозг, пейсмейкер, 9 клеток тела (ганглий, мышца-сустав, реснички) x 3, нейрон зрелости.
    // Ганглии ведут волну изгиба от головы к хвосту, суставы гнут цепочку, реснички толкают её вперёд.
    сегменты = [рот, глаз, глаз_стена, я["мозг"], я["пейсмейкер"]]
    for k = 0 to 2 {
        push(сегменты, я["ганглий" + k])
        push(сегменты, шея)
        push(сегменты, ресн)
    }
    хвост = г.новая()
    нейрон_зрелости(г, хвост, жёсткость)
    зона = зоны_роста(г, сегменты, хвост, жёсткость)
    растущая(г, 0, цвет, жёсткость)
    г.назвать(0, "Зигота")
    вперёд(г, 0, рот, зона + 1)
    return г
}

// ---------------------------------------------------------------- рыбы
// Рыба: вытянутое тело в 4 клетки шириной. Передние сегменты покрыты ресничками (без мышц): они тянут рыбу вперёд; задние —
// мускулистый хвостовой стебель; на конце — широкий хвостовой плавник. Как у настоящих рыб, голова почти не виляет, а
// работает хвост. рот_вид: 1 — клыки (хищник), 2 — губы (мирная). второй_глаз — как у головы(). сегментов — длина тела,
// корпус — сколько передних сегментов в ресничном покрове.
function рыба(имя, цвет, чешуя_цвет, рот_вид, второй_глаз, сила_пищи, сегментов, корпус) {
    г = Геном(имя)
    жёсткость = 0.45
    я = нервные_моды(г, жёсткость, 0.6)
    левая = г.новая()
    правая = г.новая()
    мышца(г, левая, true, 0.3, 0.5)
    мышца(г, правая, false, 0.3, 0.5)
    г.клетка(левая, МИОЦИТ, [0.95, 0.45, 0.35])
    г.клетка(правая, МИОЦИТ, [0.95, 0.45, 0.35])
    // Ресничный покров передней части тела тянет рыбу вперёд, а мышечный хвост работает и толкателем, и рулём.
    ресн_рыбы = г.новая()
    ресничная(г, ресн_рыбы, чешуя_цвет, жёсткость, 1.0)
    // Сегменты: (сегмент -> левая и правая половины -> бок и нервная клетка), бок — реснички или мышца.
    сег_корпус = {}
    сег_хвост = {}
    for t = 0 to ЧИСЛО_ВИДОВ - 1 {
        вид = ВИДЫ[t]
        for вариант = 0 to 1 {
            s = г.новая()
            л = г.новая()
            п = г.новая()
            бок_л = ресн_рыбы
            бок_п = ресн_рыбы
            ж = жёсткость
            if вариант == 1 {
                бок_л = левая
                бок_п = правая
                ж = 0.3
            }
            растущая(г, s, цвет, ж)
            вбок(г, s, БОК, л, п)
            растущая(г, л, цвет, ж)
            вбок(г, л, БОК, бок_л, я[вид])
            растущая(г, п, цвет, ж)
            вбок(г, п, -БОК, бок_п, я[вид])
            if вариант == 0 {
                г.назвать(s, "Корпус: " + ИМЕНА_ВИДОВ[t])
                сег_корпус[вид] = s
            } else {
                г.назвать(s, "Хвостовой стебель: " + ИМЕНА_ВИДОВ[t])
                сег_хвост[вид] = s
            }
            г.назвать(л, "Левая половина: " + ИМЕНА_ВИДОВ[t])
            г.назвать(п, "Правая половина: " + ИМЕНА_ВИДОВ[t])
        }
    }
    сегменты = []
    for k = 0 to сегментов - 1 {
        вид = вид_ядра(k, 3)
        if k < корпус { push(сегменты, сег_корпус[вид]) } else { push(сегменты, сег_хвост[вид]) }
    }
    // Хвостовой плавник: нейрон зрелости в середине, по бокам веер из лёгких жёстких лучей.
    хвост = г.новая()
    хвост_л = г.новая()
    хвост_п = г.новая()
    луч = г.новая()
    нерв = г.новая()
    нейрон_зрелости(г, нерв, жёсткость)
    растущая(г, хвост, цвет, 0.8)
    вбок(г, хвост, БОК, хвост_л, хвост_п)
    растущая(г, хвост_л, цвет, 0.8)
    вбок(г, хвост_л, БОК, луч, нерв)
    растущая(г, хвост_п, цвет, 0.8)
    вбок(г, хвост_п, -БОК, луч, нерв)
    конечная(г, луч, КЕРАТИНОЦИТ, чешуя_цвет, 0.8)
    г.назвать(хвост, "Хвост")
    г.назвать(хвост_л, "Хвост, левая лопасть")
    г.назвать(хвост_п, "Хвост, правая лопасть")
    г.назвать(луч, "Луч плавника")
    зона = зоны_роста(г, сегменты, хвост, жёсткость)
    голова(г, зона, жёсткость, рот_вид, второй_глаз, сила_пищи)
    return г
}

// Золотая рыбка: мирная, губы вместо клыков, глаза на пищу и на хищников.
function рыбка() {
    return рыба("Золотая рыбка", [0.98, 0.62, 0.30], [1.0, 0.74, 0.28], 2,
                [ЦЕЛЬ_КЛЕТКИ, -15, ЦВЕТ_ХИЩНИКА, [0.95, 0.95, 0.60], "Глаз на хищников"], 8, 12, 3)
}

// Пиранья: та же рыба, но с клыками и носом на кровь. Раненая или укушенная клетка оставляет в воде облачко сока —
// пиранья чует его за 300 мкм и плывёт туда. Свою кровь не путает с чужой? Путает. Но об этом лучше не думать.
function пиранья() {
    return рыба("Пиранья", [0.62, 0.66, 0.74], [0.78, 0.80, 0.86], 1,
                [ЦЕЛЬ_КРОВЬ, 40, ВСЁ, [0.92, 0.30, 0.30], "Нос на кровь"], 5, 12, 3)
}

// ---------------------------------------------------------------- хищная водоросль
// Неподвижное растение: липкий корень (глюеоцит), стебель с листьями, развилка и на каждой ветке челюсти-ловушка.
// Челюсть — два зуба-деворoцита на шарнирах-миоцитах (правый зеркальный). Глаз у пасти видит красных и оранжевых
// животных (черви, рыбы) и выбрасывает S1; шарниры от S1 изгибаются и захлопывают зубы, зубы высасывают добычу.
function хищная_водоросль() {
    г = Геном("Хищная водоросль")
    жёсткость = 0.8
    лист = [0.36, 0.72, 0.34]
    стебель = [0.30, 0.58, 0.30]
    корень = 1
    узлов = 3
    С0 = 2                     // стебель: узел k -> (узел k+1, лист-узел); 3 узла
    ЛУ = С0 + узлов            // лист-узел: (лист, середина)
    СЕР = ЛУ + 1               // середина: (лист, клетка стебля)
    ЛИСТ = СЕР + 1
    КЛЕТКА = ЛИСТ + 1
    РАЗВИЛКА = КЛЕТКА + 1
    В0 = РАЗВИЛКА + 1          // ветка: 2 узла
    ГОЛОВА = В0 + 2
    ЧЕЛЮСТЬ = ГОЛОВА + 1
    ШАРНИР = ЧЕЛЮСТЬ + 1
    ЗУБ = ШАРНИР + 1
    МЫШЦА = ЗУБ + 1
    ГЛАЗ = МЫШЦА + 1
    РУКА = ГЛАЗ + 1
    ОСНОВА = РУКА + 1
    растущая(г, 0, стебель, жёсткость)
    г.назвать(0, "Зигота")
    г.ребёнок(0, 0, С0, 0)
    г.ребёнок(0, 1, корень, 0)
    конечная(г, корень, ГЛЮЕОЦИТ, [0.85, 0.78, 0.35], жёсткость)
    г.назвать(корень, "Липкий корень")
    for k = 0 to узлов - 1 {
        i = С0 + k
        растущая(г, i, стебель, жёсткость)
        г.назвать(i, "Стебель " + (k + 1))
        дальше = РАЗВИЛКА
        if k + 1 < узлов { дальше = i + 1 }
        г.ребёнок(i, 0, дальше, 0)
        г.ребёнок(i, 1, ЛУ, 0)
    }
    растущая(г, ЛУ, стебель, жёсткость)
    вбок(г, ЛУ, БОК, ЛИСТ, СЕР)
    растущая(г, СЕР, стебель, жёсткость)
    вбок(г, СЕР, -БОК, ЛИСТ, КЛЕТКА)
    конечная(г, ЛИСТ, ФОТОЦИТ, лист, жёсткость)
    конечная(г, КЛЕТКА, ФОТОЦИТ, стебель, жёсткость)
    г.назвать(ЛУ, "Узел с листьями")
    г.назвать(СЕР, "Узел, середина")
    г.назвать(ЛИСТ, "Лист")
    г.назвать(КЛЕТКА, "Стебель")
    // Развилка: две ветки под 35° вперёд.
    растущая(г, РАЗВИЛКА, стебель, жёсткость)
    г.назвать(РАЗВИЛКА, "Развилка")
    г.поле(РАЗВИЛКА, "splitAngle", БОК)
    г.ребёнок(РАЗВИЛКА, 0, В0, -55)
    г.ребёнок(РАЗВИЛКА, 1, В0, -125)
    for k = 0 to 1 {
        i = В0 + k
        растущая(г, i, стебель, жёсткость)
        г.назвать(i, "Ветка " + (k + 1))
        дальше = ГОЛОВА
        if k == 0 { дальше = i + 1 }
        г.ребёнок(i, 0, дальше, 0)
        г.ребёнок(i, 1, ЛУ, 0)
    }
    // Голова: спереди челюсть, сзади глаз.
    растущая(г, ГОЛОВА, [0.55, 0.30, 0.45], жёсткость)
    г.назвать(ГОЛОВА, "Голова-ловушка")
    г.ребёнок(ГОЛОВА, 0, ЧЕЛЮСТЬ, 0)
    г.ребёнок(ГОЛОВА, 1, ГЛАЗ, 0)
    растущая(г, ЧЕЛЮСТЬ, [0.55, 0.30, 0.45], жёсткость)
    г.назвать(ЧЕЛЮСТЬ, "Челюсть")
    г.поле(ЧЕЛЮСТЬ, "splitAngle", БОК)
    г.ребёнок(ЧЕЛЮСТЬ, 0, ШАРНИР, -45)
    г.поле(ЧЕЛЮСТЬ, "child 1", "" + ШАРНИР + " -135 1 1")   // правая половина зеркальная, створки буквой V
    растущая(г, ШАРНИР, [0.55, 0.30, 0.45], жёсткость)
    г.назвать(ШАРНИР, "Шарнир")
    г.ребёнок(ШАРНИР, 0, РУКА, 0)
    г.ребёнок(ШАРНИР, 1, МЫШЦА, 0)
    растущая(г, РУКА, [0.55, 0.30, 0.45], жёсткость)
    г.назвать(РУКА, "Створка")
    г.ребёнок(РУКА, 0, ЗУБ, 0)
    г.ребёнок(РУКА, 1, ОСНОВА, 0)
    // У основания створки — хватоцит: пока глаз видит животное (S1), он держит добычу, чтобы та не выскользнула из
    // захлопнутой пасти; добыча уходит — хватка разжимается.
    конечная(г, ОСНОВА, ХВАТОЦИТ, [0.62, 0.28, 0.58], жёсткость)
    г.назвать(ОСНОВА, "Хватательная клетка")
    г.программа(ОСНОВА, П_ПЛАВАНИЕ, ВХОД_S1, СТУПЕНЬКА, 0, 0.5, 0.05)
    конечная(г, ЗУБ, ДЕВОРОЦИТ, [0.50, 0.20, 0.55], жёсткость)
    г.назвать(ЗУБ, "Зуб")
    конечная(г, МЫШЦА, МИОЦИТ, [0.62, 0.28, 0.48], жёсткость)
    г.назвать(МЫШЦА, "Мышца челюсти")
    г.программа(МЫШЦА, П_ИЗГИБ, ВХОД_S1, СТУПЕНЬКА, 0.6, -0.6, 0.05)
    конечная(г, ГЛАЗ, СЕНСОЦИТ, [0.95, 0.80, 0.30], жёсткость)
    г.назвать(ГЛАЗ, "Глаз ловушки")
    г.поле(ГЛАЗ, "sense", "" + ЦЕЛЬ_КЛЕТКИ + " 0 60 0.92 0.48 0.40 0.3")
    return г
}


// ---------------------------------------------------------------- разумник
// Небольшое существо с настоящим «поведением». Плывёт четырьмя жгутиками: два рулевых (сила зависит от S1) и
// два тяговых (сила от S4). Сигналы:
//   S2 — где пища (стереоглаз: + слева, - справа),
//   S3 — где опасность: хищник или стена (стереоглаза),
//   S1 — решение мыслителя: к пище, но в 2.5 раза сильнее — прочь от опасности; плюс медленное покачивание
//        курса исследователя, чтобы искать пищу, когда её не видно,
//   S4 — тревога и голод: сенсор страха видит хищника рядом, нейрон памяти держит испуг (затухает медленно), а
//        когда клетка мозга худеет — включает спешку. Тяговые жгутики работают сильнее при тревоге и голоде.
// Тело голубое: свои глаза не путают его с красными хищниками.
function разумник() {
    г = Геном("Разумник")
    жёсткость = 0.85
    тело = [0.30, 0.62, 0.72]
    мозг_цвет = [0.95, 0.85, 0.55]
    // Тело 2 x 6, ряды от головы к хвосту:
    //   глаз на пищу | глаз на хищников
    //   рот          | глаз на стены
    //   мыслитель    | мыслитель        (обе стороны одинаковые: решение рождается рядом с обоими рулями)
    //   руль левый   | руль правый      (сразу за мозгом: сигнал поворота не успевает затухнуть)
    //   страх        | память и поиск
    //   тяга         | тяга
    голова = г.новая()
    ряд_глаз = г.новая()
    ряд_рта = г.новая()
    туловище = г.новая()
    ряд_мозга = г.новая()
    ряд_рулей = г.новая()
    шея = г.новая()
    зад = г.новая()
    ряд_чувств = г.новая()
    ряд_тяги = г.новая()
    ГЛАЗ_ПИЩА = г.новая()
    ГЛАЗ_ОПАСНОСТЬ = г.новая()
    РОТ = г.новая()
    ГЛАЗ_СТЕНА = г.новая()
    МЫСЛИТЕЛЬ = г.новая()
    РУЛЬ_Л = г.новая()
    РУЛЬ_П = г.новая()
    СТРАХ = г.новая()
    ПАМЯТЬ = г.новая()
    ТЯГА = г.новая()
    растущая(г, 0, тело, жёсткость)
    г.назвать(0, "Зигота")
    вперёд(г, 0, голова, туловище)
    растущая(г, голова, тело, жёсткость)
    г.назвать(голова, "Голова")
    вперёд(г, голова, ряд_рулей, шея)
    растущая(г, шея, тело, жёсткость)
    г.назвать(шея, "Шея")
    вперёд(г, шея, ряд_мозга, ряд_глаз)
    // Рули на носу смотрят наискосок наружу (±45°): левый тянет нос влево, правый — вправо. Рычаг длинный, поэтому
    // даже небольшая разница поворачивает всё тело (два задних жгутика так не могут: тело не скользит вбок).
    растущая(г, ряд_рулей, тело, жёсткость)
    г.поле(ряд_рулей, "splitAngle", БОК)
    г.ребёнок(ряд_рулей, 0, РУЛЬ_Л, -БОК + 45)
    г.ребёнок(ряд_рулей, 1, РУЛЬ_П, -БОК - 45)
    г.назвать(ряд_рулей, "Рули")
    пара(г, ряд_мозга, мозг_цвет, жёсткость, МЫСЛИТЕЛЬ)
    г.назвать(ряд_мозга, "Мозг")
    растущая(г, ряд_глаз, тело, жёсткость)
    вбок(г, ряд_глаз, БОК, ГЛАЗ_ПИЩА, ГЛАЗ_ОПАСНОСТЬ)
    г.назвать(ряд_глаз, "Глаза")
    растущая(г, туловище, тело, жёсткость)
    г.назвать(туловище, "Туловище")
    вперёд(г, туловище, ряд_рта, зад)
    растущая(г, ряд_рта, тело, жёсткость)
    вбок(г, ряд_рта, БОК, РОТ, ГЛАЗ_СТЕНА)
    г.назвать(ряд_рта, "Рот и глаз на стены")
    растущая(г, зад, тело, жёсткость)
    г.назвать(зад, "Зад")
    вперёд(г, зад, ряд_чувств, ряд_тяги)
    растущая(г, ряд_чувств, тело, жёсткость)
    вбок(г, ряд_чувств, БОК, СТРАХ, ПАМЯТЬ)
    г.назвать(ряд_чувств, "Чувства")
    пара(г, ряд_тяги, тело, жёсткость, ТЯГА)
    г.назвать(ряд_тяги, "Тяга")

    // Глаза: пища -> S2 (+ слева, - справа); хищники и стены -> S3.
    конечная(г, ГЛАЗ_ПИЩА, СТЕРЕОЦИТ, [0.98, 0.80, 0.30], жёсткость)
    г.назвать(ГЛАЗ_ПИЩА, "Глаз на пищу")
    г.поле(ГЛАЗ_ПИЩА, "sense", "" + ЦЕЛЬ_ПИЩА + " 1 40 1 1 1 0")
    конечная(г, ГЛАЗ_ОПАСНОСТЬ, СТЕРЕОЦИТ, [1.0, 0.92, 0.55], жёсткость)
    г.назвать(ГЛАЗ_ОПАСНОСТЬ, "Глаз на хищников")
    г.поле(ГЛАЗ_ОПАСНОСТЬ, "sense", "" + ЦЕЛЬ_КЛЕТКИ + " 2 40 " + ЦВЕТ_ХИЩНИКА)
    конечная(г, ГЛАЗ_СТЕНА, СТЕРЕОЦИТ, [0.80, 0.82, 0.92], жёсткость)
    г.назвать(ГЛАЗ_СТЕНА, "Глаз на стены")
    г.поле(ГЛАЗ_СТЕНА, "sense", "" + ЦЕЛЬ_СТЕНА + " 2 40 1 1 1 0")
    конечная(г, РОТ, ФАГОЦИТ, [0.55, 0.80, 0.85], жёсткость)
    г.назвать(РОТ, "Рот")
    // Мыслитель: S1 = 6·S2 - 15·S3 — к пище, но прочь от опасности сильнее (с насыщением ±20).
    нейрон(г, МЫСЛИТЕЛЬ, [1.0, 0.88, 0.50], жёсткость)
    г.назвать(МЫСЛИТЕЛЬ, "Мыслитель (куда плыть)")
    г.программа(МЫСЛИТЕЛЬ, П_ВЫХОД1, ВХОД_S2, ЛИНЕЙНАЯ, 6, 0, 0)
    г.программа(МЫСЛИТЕЛЬ, П_ВЫХОД2, ВХОД_S3, ЛИНЕЙНАЯ, -15, 0, 0)
    г.поле(МЫСЛИТЕЛЬ, "neuro", "0 0 2 3")
    // Рули: S1 > 0 (цель слева) — левый тянет нос влево; S1 < 0 — правый вправо.
    конечная(г, РУЛЬ_Л, ФЛАГЕЛЛОЦИТ, [0.35, 0.55, 0.95], жёсткость)
    г.назвать(РУЛЬ_Л, "Руль левый")
    г.программа(РУЛЬ_Л, П_ПЛАВАНИЕ, ВХОД_S1, ЛИНЕЙНАЯ, 0.12, 0.15, 0)
    конечная(г, РУЛЬ_П, ФЛАГЕЛЛОЦИТ, [0.35, 0.55, 0.95], жёсткость)
    г.назвать(РУЛЬ_П, "Руль правый")
    г.программа(РУЛЬ_П, П_ПЛАВАНИЕ, ВХОД_S1, ЛИНЕЙНАЯ, -0.12, 0.15, 0)
    // Страх: хищник рядом (с любой стороны) -> тревога S4.
    конечная(г, СТРАХ, СЕНСОЦИТ, [1.0, 0.70, 0.40], жёсткость)
    г.назвать(СТРАХ, "Сенсор страха")
    г.поле(СТРАХ, "sense", "" + ЦЕЛЬ_КЛЕТКИ + " 3 40 " + ЦВЕТ_ХИЩНИКА)
    // Память: тревога затухает медленно, голод (худая клетка) — спешка, боль (ранение мозга) — паника; третий выход —
    // поиск: медленно покачивает
    // курс, чтобы обследовать чашку, когда ничего не видно.
    нейрон(г, ПАМЯТЬ, [1.0, 0.80, 0.45], жёсткость)
    г.назвать(ПАМЯТЬ, "Память, голод и поиск")
    г.программа(ПАМЯТЬ, П_ВЫХОД1, ВХОД_S4, ЛИНЕЙНАЯ, 0.8, 0, 0)
    г.программа(ПАМЯТЬ, П_ВЫХОД2, ВХОД_МАССА, СТУПЕНЬКА, 8, 0, 0.38)
    г.программа(ПАМЯТЬ, П_ВЫХОД3, ВХОД_ВОЗРАСТ, ВОЛНА, 4, 0, 0.7)
    г.программа(ПАМЯТЬ, П_ВЫХОД4, ВХОД_РАНЕНИЕ, ЛИНЕЙНАЯ, 60, 0, 0)   // боль: ранен — бежать со всех жгутиков
    г.поле(ПАМЯТЬ, "neuro", "3 3 0 3")
    // Тяга сильнее при тревоге и голоде.
    конечная(г, ТЯГА, ФЛАГЕЛЛОЦИТ, [0.30, 0.45, 0.90], жёсткость)
    г.назвать(ТЯГА, "Тяговый жгутик")
    г.программа(ТЯГА, П_ПЛАВАНИЕ, ВХОД_S4, ЛИНЕЙНАЯ, 0.05, 0.3, 0)
    // Плотный цитоскелет: тело не мнётся, как разваренное.
    for i = 0 to ТЯГА { г.поле(i, "cytoskeleton", 1.6) }
    return г
}

// ---------------------------------------------------------------- инфузория-туфелька
// Одноклеточная по жизни, многоклеточная по необходимости: овальное тело в 2 клетки шириной, покрытое ресничками.
// Глаз на пищу пишет в S6 (+ слева, − справа); за ротовой воронкой — пара вёсел наискосок: когда пища слева, левое
// гребёт сильнее и разворачивает нос к еде. Остальные реснички гребут ровно и толкают туфельку вперёд.
function инфузория() {
    г = Геном("Инфузория-туфелька")
    жёсткость = 0.7
    цвет = [0.72, 0.84, 0.92]
    рот = г.новая()
    губа = г.новая()
    вёсла_ряд = г.новая()
    глаза = г.новая()
    глаз = г.новая()
    бок = г.новая()
    ресн = г.новая()
    вакуоль = г.новая()
    хвост = г.новая()
    пара(г, рот, цвет, жёсткость, губа)
    конечная(г, губа, ФАГОЦИТ, [0.92, 0.72, 0.55], жёсткость)
    г.назвать(губа, "Ротовая воронка")
    вёсла(г, вёсла_ряд, цвет, жёсткость, ЦИЛИОЦИТ, ВХОД_S6, 0.2, 0.3, [0.50, 0.62, 0.95])
    пара(г, глаза, цвет, жёсткость, глаз)
    стереоглаз(г, глаз, ЦЕЛЬ_ПИЩА, 10, ВСЁ, [0.98, 0.60, 0.35], "Глазок на пищу")
    пара(г, бок, цвет, жёсткость, ресн)
    конечная(г, ресн, ЦИЛИОЦИТ, [0.55, 0.68, 0.95], жёсткость)
    г.программа(ресн, П_ЛЕВЫЕ_РЕСНИЧКИ, ВХОД_КОНСТАНТА, ЛИНЕЙНАЯ, 0, 0.35, 0)
    г.программа(ресн, П_ПРАВЫЕ_РЕСНИЧКИ, ВХОД_КОНСТАНТА, ЛИНЕЙНАЯ, 0, 0.35, 0)
    г.назвать(ресн, "Реснички")
    г.назвать(бок, "Ряд ресничек")
    конечная(г, вакуоль, ЛИПОЦИТ, [0.95, 0.88, 0.62], жёсткость)
    г.назвать(вакуоль, "Пищеварительная вакуоль")
    пара(г, хвост, цвет, жёсткость, вакуоль)
    г.назвать(хвост, "Задний конец")
    сегменты = [рот, вёсла_ряд, глаза, бок, бок, бок]
    зона = зоны_роста(г, сегменты, хвост, жёсткость)
    растущая(г, 0, цвет, жёсткость)
    г.назвать(0, "Зигота")
    вперёд(г, 0, рот, зона + 1)
    return г
}

// ---------------------------------------------------------------- гидра
// Пресноводный полип: липкая подошва держится за дно, стебелёк фотосинтезирует, наверху рот и щупальца из книдоцитов.
// Всё, что проплывает мимо щупалец, получает ядовитую нить и замирает, а рот (деворoцит) неспешно обедает.
function гидра() {
    г = Геном("Гидра")
    жёсткость = 0.5
    тело = [0.62, 0.78, 0.66]
    подошва = г.новая()
    стебель = г.новая()
    стебель2 = г.новая()
    голова = г.новая()
    рот = г.новая()
    венец = г.новая()
    основание = г.новая()
    стрекало = г.новая()
    кончик = г.новая()
    растущая(г, 0, тело, жёсткость)
    г.назвать(0, "Зигота")
    вперёд(г, 0, голова, стебель)
    растущая(г, стебель, тело, жёсткость)
    г.назвать(стебель, "Стебелёк")
    вперёд(г, стебель, стебель2, подошва)
    растущая(г, стебель2, тело, жёсткость)
    г.назвать(стебель2, "Стебелёк, верх")
    фото = г.новая()
    конечная(г, фото, ФОТОЦИТ, [0.45, 0.76, 0.42], жёсткость)
    г.назвать(фото, "Зелёная клетка стебелька")
    вперёд(г, стебель2, фото, фото)
    конечная(г, подошва, ГЛЮЕОЦИТ, [0.88, 0.80, 0.42], жёсткость)
    г.назвать(подошва, "Липкая подошва")
    // Голова: рот впереди, венец щупалец сзади (венец делится на два щупальца в стороны).
    растущая(г, голова, [0.70, 0.82, 0.62], жёсткость)
    г.назвать(голова, "Голова")
    вперёд(г, голова, рот, венец)
    конечная(г, рот, ДЕВОРОЦИТ, [0.80, 0.30, 0.38], жёсткость)
    г.назвать(рот, "Рот")
    растущая(г, венец, [0.70, 0.82, 0.62], жёсткость)
    г.назвать(венец, "Венец щупалец")
    г.поле(венец, "splitAngle", БОК)
    г.ребёнок(венец, 0, основание, -50)
    г.поле(венец, "child 1", "" + основание + " -130 1 1")
    // Щупальце: гибкая цепочка из трёх книдоцитов.
    растущая(г, основание, [0.70, 0.82, 0.62], 0.15)
    г.назвать(основание, "Щупальце")
    вперёд(г, основание, стрекало, кончик)
    растущая(г, кончик, [0.70, 0.82, 0.62], 0.15)
    г.назвать(кончик, "Щупальце, кончик")
    вперёд(г, кончик, стрекало, стрекало)
    конечная(г, стрекало, 19, [0.92, 0.55, 0.32], 0.15)
    г.назвать(стрекало, "Стрекательная клетка")
    г.программа(стрекало, П_ПЛАВАНИЕ, ВХОД_КОНСТАНТА, ЛИНЕЙНАЯ, 0, 1, 0)
    return г
}

// ---------------------------------------------------------------- электрический угорь
// Тонкое тело 2 × 20, как у тонкого червя, но ряды ресничек заменены электрическим органом. Электроциты бьют током
// раз в полчаса (на всякий случай — угорь не очень разборчив), оглушённая добыча замирает, и рот-деворoцит её доедает.
function угорь() {
    г = Геном("Электрический угорь")
    жёсткость = 0.35
    цвет = [0.42, 0.50, 0.62]
    я = нервные_моды(г, жёсткость, 0.6)
    левая = г.новая()
    правая = г.новая()
    мышечный = г.новая()
    мышца(г, левая, true, жёсткость, 0.5)
    мышца(г, правая, false, жёсткость, 0.5)
    растущая(г, мышечный, цвет, жёсткость)
    вбок(г, мышечный, БОК, левая, правая)
    г.назвать(мышечный, "Ряд мышц")
    эл = г.новая()
    эл_ряд = г.новая()
    конечная(г, эл, 18, [0.40, 0.62, 0.98], жёсткость)
    г.назвать(эл, "Электроцит")
    г.программа(эл, П_ПЛАВАНИЕ, ВХОД_ВОЗРАСТ, ВОЛНА, 1, 0.2, 0.5)
    пара(г, эл_ряд, цвет, жёсткость, эл)
    г.назвать(эл_ряд, "Электрический орган")
    ряд = {}
    for t = 0 to ЧИСЛО_ВИДОВ - 1 {
        вид = ВИДЫ[t]
        r = г.новая()
        пара(г, r, цвет, жёсткость, я[вид])
        г.назвать(r, "Ряд: " + ИМЕНА_ВИДОВ[t])
        ряд[вид] = r
    }
    рот = г.новая()
    зуб = г.новая()
    глаза = г.новая()
    глаз = г.новая()
    стенные = г.новая()
    глаз_стена = г.новая()
    пара(г, рот, цвет, жёсткость, зуб)
    конечная(г, зуб, ДЕВОРОЦИТ, [0.80, 0.25, 0.32], жёсткость)
    г.назвать(зуб, "Зубы")
    пара(г, глаза, цвет, жёсткость, глаз)
    стереоглаз(г, глаз, ЦЕЛЬ_ПИЩА, 8, ВСЁ, [0.98, 0.52, 0.30], "Глаз на пищу")
    пара(г, стенные, цвет, жёсткость, глаз_стена)
    стереоглаз(г, глаз_стена, ЦЕЛЬ_СТЕНА, -15, ВСЁ, [0.75, 0.75, 0.85], "Глаз на стены")
    г.назвать(рот, "Рот")
    г.назвать(глаза, "Ряд глаз")
    г.назвать(стенные, "Ряд глаз на стены")
    сегменты = [рот, глаза, стенные, ряд["мозг"], мышечный, ряд["пейсмейкер"]]
    ресн = г.новая()
    ресн_ряд = г.новая()
    ресничная(г, ресн, [0.50, 0.60, 0.90], жёсткость, 0.8)
    пара(г, ресн_ряд, цвет, жёсткость, ресн)
    г.назвать(ресн_ряд, "Ряд ресничек")
    узор = ["г", "м", "э", "р"]
    ганглиев = 0
    for k = 0 to 12 {
        вид = узор[k % 4]
        if вид == "г" {
            push(сегменты, ряд["ганглий" + (ганглиев % ЗВЕНЬЕВ)])
            ганглиев = ганглиев + 1
        }
        if вид == "м" { push(сегменты, мышечный) }
        if вид == "э" { push(сегменты, эл_ряд) }
        if вид == "р" { push(сегменты, ресн_ряд) }
    }
    хвост = г.новая()
    хвост_н = г.новая()
    нейрон_зрелости(г, хвост_н, жёсткость)
    пара(г, хвост, цвет, жёсткость, хвост_н)
    г.назвать(хвост, "Хвост")
    зона = зоны_роста(г, сегменты, хвост, жёсткость)
    растущая(г, 0, цвет, жёсткость)
    г.назвать(0, "Зигота")
    вперёд(г, 0, рот, зона + 1)
    return г
}

// ---------------------------------------------------------------- эвглена
// Зелёный жгутиконосец со светочувствительным глазком. Днём плывёт к свету и фотосинтезирует, ночью — на любой
// огонёк: светящуюся ночесветку или приманку удильщика (что обычно заканчивается плохо). Тело:
//   весло | весло       (жгутики наискосок наружу: когда свет слева, левый тянет сильнее и нос поворачивает к свету)
//   глазок | глазок     (стереоцит «Свет»: + свет слева, − справа, в S1)
//   почка | почка       (хлоропласты; сытая почка отпочковывает новую эвглену)
//       жгутик          (тянет вперёд)
function эвглена() {
    г = Геном("Эвглена")
    жёсткость = 0.85
    тело = [0.46, 0.80, 0.42]
    перед = г.новая()
    зад = г.новая()
    ряд_вёсел = г.новая()
    ряд_глаз = г.новая()
    ряд_фото = г.новая()
    ГЛАЗОК = г.новая()
    ПОЧКА = г.новая()
    ЖГУТИК = г.новая()
    растущая(г, 0, тело, жёсткость)
    г.назвать(0, "Зигота")
    вперёд(г, 0, перед, зад)
    растущая(г, перед, тело, жёсткость)
    г.назвать(перед, "Перед")
    вперёд(г, перед, ряд_вёсел, ряд_глаз)
    вёсла(г, ряд_вёсел, тело, жёсткость, ФЛАГЕЛЛОЦИТ, ВХОД_S1, 0.05, 0.15, [0.40, 0.70, 0.55])
    пара(г, ряд_глаз, тело, жёсткость, ГЛАЗОК)
    г.назвать(ряд_глаз, "Глазки")
    растущая(г, зад, тело, жёсткость)
    г.назвать(зад, "Зад")
    вперёд(г, зад, ряд_фото, ЖГУТИК)
    пара(г, ряд_фото, тело, жёсткость, ПОЧКА)
    г.назвать(ряд_фото, "Хлоропласты")
    конечная(г, ГЛАЗОК, СТЕРЕОЦИТ, [0.95, 0.40, 0.25], жёсткость)
    г.назвать(ГЛАЗОК, "Красный глазок (на свет)")
    г.поле(ГЛАЗОК, "sense", "" + ЦЕЛЬ_СВЕТ + " 0 40 1 1 1 0")
    // Почка: фотоцит, который у сытой эвглены отделяет зиготу (без адгезина) и остаётся на месте.
    г.клетка(ПОЧКА, ФОТОЦИТ, [0.50, 0.84, 0.40])
    г.поле(ПОЧКА, "stiffness", жёсткость)
    г.поле(ПОЧКА, "splitMass", 3.4)
    г.поле(ПОЧКА, "priority", 0.3)
    г.поле(ПОЧКА, "splitAngle", 180)
    г.поле(ПОЧКА, "child 0", "0 180 0 0")
    г.поле(ПОЧКА, "child 1", "" + ПОЧКА + " 180 1 0")
    г.назвать(ПОЧКА, "Почка")
    конечная(г, ЖГУТИК, ФЛАГЕЛЛОЦИТ, [0.36, 0.62, 0.52], жёсткость)
    г.назвать(ЖГУТИК, "Жгутик")
    г.программа(ЖГУТИК, П_ПЛАВАНИЕ, ВХОД_КОНСТАНТА, ЛИНЕЙНАЯ, 0, 0.8, 0)
    for i = 0 to г.счёт - 1 { г.поле(i, "cytoskeleton", 1.6) }
    return г
}

// ---------------------------------------------------------------- удильщик
// Засадный хищник тёмной воды. Над пастью — светящаяся приманка (люминоцит): ночью или в темноте она горит, и всё,
// что плывёт на свет, плывёт прямо в пасть. Ряды от головы к хвосту:
//   зуб | приманка | зуб        (деворoциты по бокам огонька)
//   хват | рот | хват           (хватоциты держат того, кто подплыл, рот-фагоцит подбирает крошки)
//   жир | икра | жир            (липоциты — запас на голодные ночи; сытая «икра» отпочковывает зиготу)
//   плавник | плавник           (медленные жгутики: удильщик едва дрейфует)
function удильщик() {
    г = Геном("Удильщик")
    жёсткость = 0.8
    тело = [0.36, 0.30, 0.42]
    голова_м = г.новая()
    тулово = г.новая()
    ряд1 = г.новая()
    ряд1_п = г.новая()
    ряд2 = г.новая()
    ряд2_п = г.новая()
    ряд3 = г.новая()
    ряд3_п = г.новая()
    ряд4 = г.новая()
    ЗУБ = г.новая()
    ПРИМАНКА = г.новая()
    ХВАТ = г.новая()
    РОТ = г.новая()
    ЖИР = г.новая()
    ИКРА = г.новая()
    ПЛАВНИК = г.новая()
    растущая(г, 0, тело, жёсткость)
    г.назвать(0, "Зигота")
    вперёд(г, 0, голова_м, тулово)
    растущая(г, голова_м, тело, жёсткость)
    г.назвать(голова_м, "Голова")
    вперёд(г, голова_м, ряд1, ряд2)
    растущая(г, тулово, тело, жёсткость)
    г.назвать(тулово, "Туловище")
    вперёд(г, тулово, ряд3, ряд4)
    // Ряд из трёх клеток: левая уходит влево, остаток делится на середину и правую.
    тройка = [[ряд1, ряд1_п, ЗУБ, ПРИМАНКА, "Пасть"], [ряд2, ряд2_п, ХВАТ, РОТ, "Челюсти"], [ряд3, ряд3_п, ЖИР, ИКРА, "Брюхо"]]
    for k = 0 to 2 {
        т = тройка[k]
        растущая(г, т[0], тело, жёсткость)
        вбок(г, т[0], БОК, т[2], т[1])
        растущая(г, т[1], тело, жёсткость)
        вбок(г, т[1], БОК, т[3], т[2])
        г.назвать(т[0], т[4])
        г.назвать(т[1], т[4] + ", правая часть")
    }
    пара(г, ряд4, тело, жёсткость, ПЛАВНИК)
    г.назвать(ряд4, "Хвост")
    конечная(г, ЗУБ, ДЕВОРОЦИТ, [0.75, 0.22, 0.30], жёсткость)
    г.назвать(ЗУБ, "Зуб")
    // Приманка горит, когда темно (свет < 0.3): днём удильщик не тратит на неё силы.
    конечная(г, ПРИМАНКА, ЛЮМИНОЦИТ, [0.62, 0.95, 0.85], жёсткость)
    г.назвать(ПРИМАНКА, "Приманка")
    г.поле(ПРИМАНКА, "sense", "0 0 0 0.55 1.0 0.85 0")
    г.программа(ПРИМАНКА, П_ПЛАВАНИЕ, ВХОД_СВЕТ, СТУПЕНЬКА, 1, 0, 0.3)
    конечная(г, ХВАТ, ХВАТОЦИТ, [0.55, 0.30, 0.50], жёсткость)
    г.назвать(ХВАТ, "Хватательная клетка")
    г.программа(ХВАТ, П_ПЛАВАНИЕ, ВХОД_КОНСТАНТА, ЛИНЕЙНАЯ, 0, 0.5, 0)
    конечная(г, РОТ, ФАГОЦИТ, [0.62, 0.42, 0.48], жёсткость)
    г.назвать(РОТ, "Рот")
    конечная(г, ЖИР, ЛИПОЦИТ, [0.90, 0.82, 0.62], жёсткость)
    г.назвать(ЖИР, "Жировой запас")
    г.клетка(ИКРА, ФАГОЦИТ, [0.92, 0.62, 0.52])
    г.поле(ИКРА, "stiffness", жёсткость)
    г.поле(ИКРА, "splitMass", 3.4)
    г.поле(ИКРА, "priority", 0.2)
    г.поле(ИКРА, "splitAngle", 180)
    г.поле(ИКРА, "child 0", "0 180 0 0")
    г.поле(ИКРА, "child 1", "" + ИКРА + " 180 1 0")
    г.назвать(ИКРА, "Икра (отпочковывает зиготу)")
    конечная(г, ПЛАВНИК, ФЛАГЕЛЛОЦИТ, [0.42, 0.36, 0.55], жёсткость)
    г.назвать(ПЛАВНИК, "Плавник")
    г.программа(ПЛАВНИК, П_ПЛАВАНИЕ, ВХОД_КОНСТАНТА, ЛИНЕЙНАЯ, 0, 0.06, 0)
    for i = 0 to ПЛАВНИК { г.поле(i, "cytoskeleton", 1.4) }
    return г
}

// ---------------------------------------------------------------- пиявка
// Тонкий червь-кровосос 2 × 19, скользит на ресничках и извивается. Впереди — присоски (хватоциты): голодная пиявка цепляется за любую чужую клетку, к
// которой прикоснулась, и держится, пока не наестся (масса присоски растёт — хватка разжимается). За присосками —
// зубы-деворoциты. Глаза на клетки любого цвета и на кровь ведут её к жертве, глаза на стены — прочь от стен.
function пиявка() {
    г = Геном("Пиявка")
    жёсткость = 0.35
    цвет = [0.36, 0.30, 0.26]
    я = нервные_моды(г, жёсткость, 0.7)
    левая = г.новая()
    правая = г.новая()
    мышечный = г.новая()
    мышца(г, левая, true, жёсткость, 0.5)
    мышца(г, правая, false, жёсткость, 0.5)
    растущая(г, мышечный, цвет, жёсткость)
    вбок(г, мышечный, БОК, левая, правая)
    г.назвать(мышечный, "Ряд мышц")
    ряд = {}
    for t = 0 to ЧИСЛО_ВИДОВ - 1 {
        вид = ВИДЫ[t]
        r = г.новая()
        пара(г, r, цвет, жёсткость, я[вид])
        г.назвать(r, "Ряд: " + ИМЕНА_ВИДОВ[t])
        ряд[вид] = r
    }
    присоски = г.новая()
    присоска = г.новая()
    рот = г.новая()
    зуб = г.новая()
    глаза = г.новая()
    глаз = г.новая()
    нос = г.новая()
    нюх = г.новая()
    стенные = г.новая()
    глаз_стена = г.новая()
    растущая(г, присоски, цвет, жёсткость)
    вбок(г, присоски, БОК, присоска, зуб)       // присоски и зубы в шахматном порядке: прижатая добыча касается и тех и других
    конечная(г, присоска, ХВАТОЦИТ, [0.62, 0.38, 0.40], жёсткость)
    г.назвать(присоска, "Присоска")
    г.программа(присоска, П_ПЛАВАНИЕ, ВХОД_МАССА, СТУПЕНЬКА, 0.5, 0, 0.75)   // голодная — держит, сытая — отпускает
    растущая(г, рот, цвет, жёсткость)
    вбок(г, рот, БОК, зуб, присоска)
    конечная(г, зуб, ДЕВОРОЦИТ, [0.80, 0.25, 0.32], жёсткость)
    г.назвать(зуб, "Зубы")
    пара(г, глаза, цвет, жёсткость, глаз)
    стереоглаз(г, глаз, ЦЕЛЬ_КЛЕТКИ, 10, "0.5 0.5 0.5 1.8", [0.98, 0.70, 0.40], "Глаз на клетки")
    пара(г, нос, цвет, жёсткость, нюх)
    стереоглаз(г, нюх, ЦЕЛЬ_КРОВЬ, 12, ВСЁ, [0.92, 0.32, 0.32], "Нос на кровь")
    пара(г, стенные, цвет, жёсткость, глаз_стена)
    стереоглаз(г, глаз_стена, ЦЕЛЬ_СТЕНА, -15, ВСЁ, [0.75, 0.75, 0.85], "Глаз на стены")
    г.назвать(присоски, "Присоски")
    г.назвать(рот, "Рот")
    г.назвать(глаза, "Ряд глаз")
    г.назвать(нос, "Ряд носов")
    г.назвать(стенные, "Ряд глаз на стены")
    сегменты = [присоски, рот, глаза, нос, стенные, ряд["мозг"], мышечный, ряд["пейсмейкер"]]
    ресн = г.новая()
    ресн_ряд = г.новая()
    ресничная(г, ресн, [0.46, 0.40, 0.50], жёсткость, 0.8)
    пара(г, ресн_ряд, цвет, жёсткость, ресн)
    г.назвать(ресн_ряд, "Ряд ресничек")
    узор = ["г", "м", "р", "м"]
    ганглиев = 0
    for k = 0 to 9 {
        вид = узор[k % 4]
        if вид == "г" {
            push(сегменты, ряд["ганглий" + (ганглиев % ЗВЕНЬЕВ)])
            ганглиев = ганглиев + 1
        }
        if вид == "м" { push(сегменты, мышечный) }
        if вид == "р" { push(сегменты, ресн_ряд) }
    }
    хвост = г.новая()
    хвост_н = г.новая()
    нейрон_зрелости(г, хвост_н, жёсткость)
    пара(г, хвост, цвет, жёсткость, хвост_н)
    г.назвать(хвост, "Хвост")
    зона = зоны_роста(г, сегменты, хвост, жёсткость)
    растущая(г, 0, цвет, жёсткость)
    г.назвать(0, "Зигота")
    вперёд(г, 0, присоски, зона + 1)
    г.рост_едой()
    return г
}

// ---------------------------------------------------------------- тихоходка
// Тихоходка 2 × 8: ротовой конус, вёсла-руль (левое гребёт сильнее, когда пища слева), глазки на пищу, ряды ножек
// с ресничками, кутикула из кератиноцитов (вся тихоходка в броне) и яичники. Сытый яичник откладывает цисту — она
// спит под бронёй, почти не тратя еды, месяцами (часами — по меркам чашки), и просыпается зиготой, только когда рядом
// окажется пища. Голод, хищники, яды — циста переждёт всё. Кроме стерилизации: против неё не помогает ничего.
function тихоходка() {
    г = Геном("Тихоходка")
    жёсткость = 0.7
    цвет = [0.86, 0.76, 0.62]
    рот = г.новая()
    губа = г.новая()
    глаза = г.новая()
    глаз = г.новая()
    бок = г.новая()
    рл = г.новая()
    рп = г.новая()   // ряд вёсел
    кутикула = г.новая()
    панцирь = г.новая()
    яичники = г.новая()
    яичник = г.новая()
    циста = г.новая()
    хвост = г.новая()
    коготь = г.новая()
    пара(г, рот, цвет, жёсткость, губа)
    конечная(г, губа, ФАГОЦИТ, [0.95, 0.70, 0.55], жёсткость)
    г.назвать(губа, "Ротовой конус")
    пара(г, глаза, цвет, жёсткость, глаз)
    стереоглаз(г, глаз, ЦЕЛЬ_ПИЩА, 10, ВСЁ, [0.30, 0.25, 0.25], "Глазок на пищу")
    пара(г, бок, цвет, жёсткость, рл)
    конечная(г, рл, ЦИЛИОЦИТ, [0.80, 0.72, 0.60], жёсткость)
    г.программа(рл, П_ЛЕВЫЕ_РЕСНИЧКИ, ВХОД_КОНСТАНТА, ЛИНЕЙНАЯ, 0, 0.45, 0)
    г.программа(рл, П_ПРАВЫЕ_РЕСНИЧКИ, ВХОД_КОНСТАНТА, ЛИНЕЙНАЯ, 0, 0.45, 0)
    г.назвать(рл, "Ножки")
    г.назвать(бок, "Ряд ножек")
    вёсла(г, рп, цвет, жёсткость, ЦИЛИОЦИТ, ВХОД_S6, 0.4, 0.4, [0.84, 0.70, 0.56])
    пара(г, кутикула, цвет, жёсткость, панцирь)
    конечная(г, панцирь, КЕРАТИНОЦИТ, [0.76, 0.66, 0.52], жёсткость)
    г.назвать(кутикула, "Кутикула")
    г.назвать(панцирь, "Панцирь")
    пара(г, яичники, цвет, жёсткость, яичник)
    г.назвать(яичники, "Яичники")
    г.клетка(яичник, ФАГОЦИТ, [0.95, 0.80, 0.70])
    г.поле(яичник, "stiffness", жёсткость)
    г.поле(яичник, "splitMass", 3.3)
    г.поле(яичник, "priority", 0.3)
    г.поле(яичник, "splitAngle", 180)
    г.поле(яичник, "child 0", "" + циста + " 180 0 0")
    г.поле(яичник, "child 1", "" + яичник + " 180 1 0")
    г.назвать(яичник, "Яичник (откладывает цисты)")
    // Циста просыпается зиготой, когда рядом есть пища.
    конечная(г, циста, ЦИСТОЦИТ, [0.70, 0.60, 0.42], 0.5)
    г.поле(циста, "stem", "0 0")
    г.программа(циста, П_ПУТЬ1, ВХОД_ЕДА, СТУПЕНЬКА, 0, 1, 0.25)
    г.назвать(циста, "Циста")
    пара(г, хвост, цвет, жёсткость, коготь)
    конечная(г, коготь, КЕРАТИНОЦИТ, [0.66, 0.56, 0.44], жёсткость)
    г.назвать(хвост, "Задние ножки")
    г.назвать(коготь, "Коготки")
    сегменты = [рот, рп, глаза, кутикула, бок, яичники, бок]
    зона = зоны_роста(г, сегменты, хвост, жёсткость)
    растущая(г, 0, цвет, жёсткость)
    г.назвать(0, "Зигота")
    вперёд(г, 0, рот, зона + 1)
    г.рост_едой()
    return г
}

// ---------------------------------------------------------------- ночесветка
// Светящаяся водоросль 2 × 4. Днём фотосинтезирует и запасает жир, ночью (свет < 0.15) зажигает огоньки на обоих
// концах. Красиво. Эвглены ночью плывут к ней, как мотыльки к фонарю, — ей от этого ни жарко ни холодно. Сытая почка
// отпочковывает новую ночесветку.
function ночесветка() {
    г = Геном("Ночесветка")
    жёсткость = 0.6
    цвет = [0.50, 0.78, 0.74]
    перед = г.новая()
    зад = г.новая()
    огни = г.новая()
    огонь = г.новая()
    зелень = г.новая()
    фото = г.новая()
    середина = г.новая()
    жир = г.новая()
    почка = г.новая()
    растущая(г, 0, цвет, жёсткость)
    г.назвать(0, "Зигота")
    вперёд(г, 0, перед, зад)
    растущая(г, перед, цвет, жёсткость)
    вперёд(г, перед, огни, середина)
    растущая(г, зад, цвет, жёсткость)
    вперёд(г, зад, зелень, огни)
    г.назвать(перед, "Передняя половина")
    г.назвать(зад, "Задняя половина")
    пара(г, огни, цвет, жёсткость, огонь)
    г.назвать(огни, "Огоньки")
    конечная(г, огонь, ЛЮМИНОЦИТ, [0.62, 0.86, 0.95], жёсткость)
    г.поле(огонь, "sense", "0 0 0 0.45 0.85 1.0 0")
    г.программа(огонь, П_ПЛАВАНИЕ, ВХОД_СВЕТ, СТУПЕНЬКА, 0.8, 0, 0.15)
    г.назвать(огонь, "Огонёк")
    пара(г, зелень, цвет, жёсткость, фото)
    конечная(г, фото, ФОТОЦИТ, [0.42, 0.76, 0.52], жёсткость)
    г.назвать(зелень, "Зелёный ряд")
    г.назвать(фото, "Фотоцит")
    растущая(г, середина, цвет, жёсткость)
    вбок(г, середина, БОК, жир, почка)
    г.назвать(середина, "Середина")
    конечная(г, жир, ЛИПОЦИТ, [0.92, 0.88, 0.62], жёсткость)
    г.назвать(жир, "Жир на ночь")
    г.клетка(почка, ФОТОЦИТ, [0.48, 0.80, 0.58])
    г.поле(почка, "stiffness", жёсткость)
    г.поле(почка, "splitMass", 3.4)
    г.поле(почка, "priority", 0.3)
    г.поле(почка, "splitAngle", -БОК)
    г.поле(почка, "child 0", "0 " + БОК + " 0 0")
    г.поле(почка, "child 1", "" + почка + " " + БОК + " 1 0")
    г.назвать(почка, "Почка")
    return г
}

// ---------------------------------------------------------------- то, что видит игра
ИМЕНА = ["Червь-гигант", "Нематода", "Золотая рыбка", "Хищная водоросль", "Разумник", "Тонкий червь", "Нитчатый червь",
         "Инфузория-туфелька", "Гидра", "Электрический угорь", "Пиранья", "Эвглена", "Удильщик", "Пиявка", "Тихоходка",
         "Ночесветка"]
ОПИСАНИЯ = [
    "45 сегментов по 10 клеток, плоский, как планария: ползёт на ресничных лентах, мышечные ленты изгибают его к пище. Собран на dypt.",
    "Всеядный хищник: ресничный покров тянет вперёд, мышцы поворачивают к цели, клыки высасывают добычу, гонады выпускают гаметы — из них яйца и новые нематоды. Собран на dypt.",
    "Мирная рыбка: реснички на передней части тела тянут вперёд, мускулистый хвост гребёт и рулит; ищет пищу, уходит от хищников. Собрана на dypt.",
    "Растение-ловушка: липкий корень, листья и челюсти, которые захлопываются, когда глаз видит животное, а хватательные клетки не дают добыче выскользнуть. Собрано на dypt.",
    "Умное существо: стереоглаза на пищу, хищников и стены, мозг выбирает курс, помнит испуг, спешит, когда голоден, удирает, когда ранен, и обследует чашку. Собрано на dypt.",
    "Тонкий червь 20 × 2 клетки: ряды мышц, нервных ганглиев и ресничек; извивается и скользит. Собран на dypt.",
    "Нитчатый червь — цепочка из 15 клеток: извивается волной и скользит ресничками. Собран на dypt.",
    "Туфелька, покрытая ресничками: скользит и поворачивает к пище, разгоняя реснички на нужном боку. Собрана на dypt.",
    "Полип: липкая подошва, зелёный стебелёк, рот и щупальца из стрекательных клеток. Ждёт, кто проплывёт мимо. Собрана на dypt.",
    "Тонкое тело с электрическим органом: раз в полчаса бьёт током и доедает оглушённых. Собран на dypt.",
    "Рыба с клыками и носом на кровь: чует клеточный сок раненых за 300 мкм и приплывает на запах. Собрана на dypt.",
    "Зелёный жгутиконосец с красным глазком: днём плывёт к свету, ночью — на любой огонёк. Отпочковывает новых эвглен. Собрана на dypt.",
    "Засадный хищник: светящаяся приманка над пастью горит в темноте, хватательные клетки держат тех, кто приплыл на свет. Собран на dypt.",
    "Червь-кровосос: голодным цепляется присосками за любую чужую клетку и отпускает, только наевшись. Чует кровь. Собрана на dypt.",
    "В броне из кутикулы, ходит на ресничных ножках. Откладывает цисты, которые спят, пока рядом не появится пища. Собрана на dypt.",
    "Светящаяся водоросль: днём фотосинтез и жир, ночью — огоньки. Эвглены летят на неё, как мотыльки. Собрана на dypt."
]

function count(): int {
    return length(ИМЕНА)
}

function name(i: int): string {
    return ИМЕНА[i]
}

function description(i: int): string {
    return ОПИСАНИЯ[i]
}

function genome(i: int): string {
    if i == 0 { return гигант().текст() }
    if i == 1 { return нематода().текст() }
    if i == 2 { return рыбка().текст() }
    if i == 3 { return хищная_водоросль().текст() }
    if i == 4 { return разумник().текст() }
    if i == 5 { return тонкий_червь().текст() }
    if i == 6 { return нитчатый_червь().текст() }
    if i == 7 { return инфузория().текст() }
    if i == 8 { return гидра().текст() }
    if i == 9 { return угорь().текст() }
    if i == 10 { return пиранья().текст() }
    if i == 11 { return эвглена().текст() }
    if i == 12 { return удильщик().текст() }
    if i == 13 { return пиявка().текст() }
    if i == 14 { return тихоходка().текст() }
    return ночесветка().текст()
}
