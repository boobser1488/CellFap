// Мигалка: S3 включается и выключается каждые 100 тиков. Счёт у каждой клетки свой, в памяти.
// входы: [S1..S8, масса, возраст, азот, связи, свет, пища, травма, память1..память4]
// ответ: [S1..S8, память1..память4]; null — оставить как было
function on_tick(входы) {
    счёт = входы[15] + 1
    горит = входы[16]
    if счёт >= 100 {
        счёт = 0
        горит = 1 - горит
    }
    return [null, null, горит, null, null, null, null, null, счёт, горит, null, null]
}
