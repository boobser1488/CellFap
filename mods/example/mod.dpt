// Пример мода CellFap (docs/mods.md).
// Точки входа (все необязательны): загрузка(), тик(состояние), настройки_изменены(), выгрузка().
// Переменные верхнего уровня живут, пока мод включён.

дождей = 0

// Один раз, когда мод включают: всё, что мод добавляет в игру.
function загрузка() {
    добавить_геном("Розовая водоросль", "genomes/pink_alga.genome.txt")
    добавить_программу("Мигалка", "programs/blinker.dpt")
    журнал("пример мода загружен")
    сообщение("Пример мода включён: геном «Розовая водоросль» — в браузере геномов, вкладка «Моды»")
}

// Точка внутри чашки радиуса r: в центре, у края или где угодно.
function точка(r, где) {
    угол = случайное() * 6.2831853
    д = случайное()
    if где == "центр" {
        д = д * 0.35
    } elif где == "край" {
        д = 0.75 + д * 0.2
    } else {
        д = 0.95 - д * д * 0.95
    }
    // без модуля math: косинус и синус рядом Тейлора хватает для разброса пищи
    x = угол - 3.14159265
    x2 = x * x
    c = -(1 - x2 / 2 + x2 * x2 / 24 - x2 * x2 * x2 / 720 + x2 * x2 * x2 * x2 / 40320)
    s = -(x - x * x2 / 6 + x * x2 * x2 / 120 - x * x2 * x2 * x2 / 5040 + x * x2 * x2 * x2 * x2 / 362880)
    return [c * д * r, s * д * r]
}

// Каждые `tick` тиков. состояние = [часы, клеток, пищи, тик].
function тик(состояние) {
    if настройка("дождь") {
        r = узнать("радиус")
        n = настройка("порций")
        for k = 1 to n {
            p = точка(r, настройка("где"))
            добавить_пищу(p[0], p[1], 0.3)
        }
        дождей = дождей + 1
        if дождей % 50 == 0 {
            журнал("дождей: ", дождей, ", клеток в чашке: ", состояние[1])
        }
    }
    if настройка("свет_по_кругу") {
        задать("направление_света", узнать("направление_света") + 0.05)
    }
}

function настройки_изменены() {
    журнал("настройки: дождь ", настройка("дождь"), ", порций ", настройка("порций"), ", где ", настройка("где"))
}

function выгрузка() {
    журнал("пример мода выключен после ", дождей, " дождей")
}
